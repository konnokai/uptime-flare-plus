{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uptime-flare-plus",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uptime-flare-plus",
      // 自己 fork 部署時，換成 `wrangler d1 create uptime-flare-plus` 給的 id
      "database_id": "be3f305e-c6ff-4c3e-bafb-90d14bba830b",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "MONITOR", "class_name": "MonitorDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MonitorDO"] }],
  "triggers": {
    // 每 5 分鐘 watchdog；每天 UTC 19:17（台灣 03:17）清舊資料
    "crons": ["*/5 * * * *", "17 19 * * *"]
  },
  "observability": { "enabled": true }
}
